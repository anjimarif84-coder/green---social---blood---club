# Copy this file to .env and set long random secrets before running.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_FILE=./data/club.sqlite
# প্রথমবার সার্ভার চালালে এই অ্যাডমিন অটো তৈরি হবে (অন্তত ১২ অক্ষরের পাসওয়ার্ড)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-now
